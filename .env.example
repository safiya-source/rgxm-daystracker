# Copy to .env.local for development. Never commit real keys.
# Local values are printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for invitations, deactivation (sign-in bans) and the daily job.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the app (used in invite / password-reset links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/cron/daily (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Optional: email notifications via Resend (also enable in Settings → Agency).
RESEND_API_KEY=
EMAIL_FROM=RGXM People <people@rgxm.com>
